# IBM Quantum (IBM Cloud Runtime) Configuration Template
# Copy this file to '.env' and insert your IBM Cloud credentials.
QISKIT_IBM_CHANNEL=ibm_cloud
QISKIT_IBM_TOKEN=your_ibm_cloud_iam_api_key_here
QISKIT_IBM_INSTANCE=crn:v1:bluemix:public:quantum-computing:us-east:a/your_account_id:your_instance_id::

# Optional target backend:
# QISKIT_IBM_BACKEND=ibm_marrakesh
